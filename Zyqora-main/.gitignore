# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
.env

# Generated model artifacts (re-create with scripts/prepare_model.py + export_*.py, or copy to the Pi)
models/*
!models/README.md
!models/.gitkeep
# Deployment model (8.47 MiB, under GitHub's 100 MB limit): committed so the Pi can deploy from git.
# Its sidecar .json holds the SHA-256 written by scripts/verify_waste_model.py.
!models/mobilenetv2_waste_fp32_xnnpack.pte
!models/mobilenetv2_waste_fp32_xnnpack.json

# Data: organiser/dev images are not committed; only READMEs and label templates
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.bmp
data/**/*.webp

# Generated outputs, benchmarks, local databases
outputs/*
!outputs/.gitkeep
*.db
*.sqlite3
*.sqlite3-*
.DS_Store
